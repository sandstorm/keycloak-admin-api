{
    "name": "sandstorm/keycloak-admin-api",
    "description": "Framework-agnostic PHP client for the Keycloak Admin REST API (users, groups, credentials, sessions, events), returning immutable typed DTOs and collections.",
    "keywords": [
        "keycloak",
        "keycloak-admin",
        "rest-api",
        "client"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Sebastian Kurfuerst",
            "email": "sebastian.kurfuerst@sandstorm.de",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "guzzlehttp/guzzle": "^7.3",
        "psr/http-message": "^1.1 || ^2.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Sandstorm\\KeycloakAdminApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sandstorm\\KeycloakAdminApi\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
